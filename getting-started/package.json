{
  "name": "@connectum/example-getting-started",
  "version": "0.1.0",
  "private": true,
  "description": "Connectum quickstart — one service with health, reflection, default interceptors, graceful shutdown; runs on Node, Bun and tsx",
  "type": "module",
  "imports": {
    "#gen/*": "./gen/*",
    "#*": "./src/*"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "start:bun": "bun src/index.ts",
    "start:tsx": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "buf:generate": "buf generate",
    "buf:lint": "buf lint",
    "build:proto": "pnpm run buf:generate",
    "test": "node --test tests/**/*.test.ts",
    "test:bun": "bun test tests/"
  },
  "keywords": [
    "connectrpc",
    "grpc",
    "connectum",
    "example",
    "quickstart",
    "getting-started"
  ],
  "author": "Highload.Zone",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=25.2.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectum/core": "^1.0.0",
    "@connectum/healthcheck": "^1.0.0",
    "@connectum/interceptors": "^1.0.0",
    "@connectum/reflection": "^1.0.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.65.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@connectrpc/connect-node": "^2.1.1",
    "@types/node": "^25.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
